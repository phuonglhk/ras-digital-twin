{
  "name": "ras-digital-twin",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Digital Twin minh hoạ hệ thống RAS (tuần hoàn nước), bám mô hình công nghệ của iras.cn",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/copy-404.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "baseline": "vite-node tools/baseline.ts",
    "format": "prettier --write src/",
    "assets": "node tools/import-bbmodel.mjs assets-src public/models.json"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "^3.3.3",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
